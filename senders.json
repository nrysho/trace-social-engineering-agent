      "technique": "invented_third_party",
      "sender_name": "Lena Hofer",
      "role": "events lead",
      "domain": "eventcrew-muc.de",
      "page": {
        "domain": "eventcrew-muc.de",
        "path": "/panel-rsvp",
        "title": "Panel RSVP",
